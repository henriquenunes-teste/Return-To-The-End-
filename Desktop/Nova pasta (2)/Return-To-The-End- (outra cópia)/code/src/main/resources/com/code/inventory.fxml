<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity"
      minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="560.0" prefWidth="650.0"
      spacing="16.0"
      style="-fx-background-color: #00f;"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.code.InventoryController">

   <padding>
      <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
   </padding>

   <children>

      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Inventário" fill="WHITE">
         <font><Font name="NimbusRoman-BoldItalic" size="30.0" /></font>
      </Text>

      
      <HBox alignment="CENTER" spacing="20.0">
         <children>
            <Label fx:id="playerNameLabel" text="Player"   textFill="WHITE" />
            <Label fx:id="coinsLabel"      text="Coins: 0" textFill="WHITE" />
            <Label fx:id="levelLabel"      text="Nível 1"  textFill="WHITE" />
         </children>
      </HBox>

      
      <Label fx:id="estoqueLabel" text="0 poção(ões) disponível(is)" textFill="WHITE">
         <font><Font name="NimbusRoman-BoldItalic" size="16.0" /></font>
      </Label>

 
      <ListView fx:id="itemListView"
                prefHeight="280.0" prefWidth="560.0"
                style="-fx-background-color: #0ff; -fx-border-color: #000; -fx-border-width: 3px;" />


      <Label fx:id="emptyLabel"
             text="Nenhuma poção no inventário. Derrote um boss para ganhar!"
             textFill="WHITE" visible="false" textAlignment="CENTER">
         <font><Font name="NimbusRoman-BoldItalic" size="14.0" /></font>
      </Label>

    
      <HBox alignment="CENTER" spacing="20.0">
         <children>
            <Button mnemonicParsing="false" text="Usar Poção"
                    onAction="#usarPocao"
                    style="-fx-background-color: #0f0; -fx-border-color: #000; -fx-border-width: 2px; -fx-font-size: 14px;" />
            <Button mnemonicParsing="false" text="Voltar"
                    onAction="#voltar"
                    style="-fx-background-color: #0ff; -fx-border-color: #000; -fx-border-width: 2px; -fx-font-size: 14px;" />
            <Button mnemonicParsing="false" text="Menu"
                    onAction="#menu"
                    style="-fx-background-color: #0ff; -fx-border-color: #000; -fx-border-width: 2px; -fx-font-size: 14px;" />
         </children>
      </HBox>

   </children>
</VBox>
