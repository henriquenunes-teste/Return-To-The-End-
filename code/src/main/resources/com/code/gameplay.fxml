<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="604.0" prefWidth="748.0"
      style="-fx-background-color: #00f;"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.code.GameplayController">

   <children>

      
      <HBox alignment="CENTER" prefHeight="195.0" prefWidth="600.0" spacing="30.0">
         <children>

      
            <Pane prefHeight="160.0" prefWidth="200.0"
                  style="-fx-background-color: #0ff; -fx-border-color: #000; -fx-border-width: 4px; -fx-cursor: hand;"
                  onMouseClicked="#abrirUpgrades">
               <children>
                  <Label layoutX="47.0" layoutY="135.0" text="Upgrades">
                     <font>
                        <Font name="NimbusRoman-BoldItalic" size="23.0" />
                     </font>
                  </Label>
                  <ImageView fitHeight="73.0" fitWidth="81.0"
                             layoutX="63.0" layoutY="59.0"
                             pickOnBounds="true" preserveRatio="true"
                             mouseTransparent="true">
                     <image>
                        <Image url="@assets/upgrade.png" />
                     </image>
                  </ImageView>
               </children>
            </Pane>

     
            <Pane prefHeight="200.0" prefWidth="200.0"
                  style="-fx-background-color: #0ff; -fx-border-color: #000; -fx-border-width: 4px; -fx-cursor: hand;"
                  onMouseClicked="#abrirRanking">
               <children>
                  <Label layoutX="56.0" layoutY="136.0" text="Ranking">
                     <font>
                        <Font name="NimbusRoman-BoldItalic" size="23.0" />
                     </font>
                  </Label>
                  <ImageView fitHeight="83.0" fitWidth="88.0"
                             layoutX="59.0" layoutY="54.0"
                             pickOnBounds="true" preserveRatio="true"
                             mouseTransparent="true">
                     <image>
                        <Image url="@assets/ranking.png" />
                     </image>
                  </ImageView>
               </children>
            </Pane>

         </children>
         <padding>
            <Insets bottom="2.0" top="2.0" />
         </padding>
      </HBox>

   
      <HBox alignment="CENTER" prefHeight="212.0" prefWidth="600.0" spacing="30.0">
         <children>

        
            <Pane prefHeight="200.0" prefWidth="200.0"
                  style="-fx-background-color: #0ff; -fx-border-color: #000; -fx-border-width: 4px; -fx-cursor: hand;"
                  onMouseClicked="#abrirInventario">
               <children>
                  <Label layoutX="44.0" layoutY="147.0" text="Inventario">
                     <font>
                        <Font name="NimbusRoman-BoldItalic" size="23.0" />
                     </font>
                  </Label>
                  <ImageView fitHeight="101.0" fitWidth="111.0"
                             layoutX="50.0" layoutY="54.0"
                             pickOnBounds="true" preserveRatio="true"
                             mouseTransparent="true">
                     <image>
                        <Image url="@assets/inventory.png" />
                     </image>
                  </ImageView>
               </children>
            </Pane>

            <!-- Botão Play -->
            <Pane prefHeight="200.0" prefWidth="200.0"
                  style="-fx-background-color: #0ff; -fx-border-width: 4px; -fx-border-color: #000; -fx-cursor: hand;"
                  onMouseClicked="#jogar">
               <children>
                  <Label layoutX="78.0" layoutY="146.0" text="Play">
                     <font>
                        <Font name="NimbusRoman-BoldItalic" size="23.0" />
                     </font>
                  </Label>
                  <ImageView fitHeight="115.0" fitWidth="121.0"
                             layoutX="43.0" layoutY="47.0"
                             pickOnBounds="true" preserveRatio="true"
                             mouseTransparent="true">
                     <image>
                        <Image url="@assets/play.png" />
                     </image>
                  </ImageView>
               </children>
            </Pane>

         </children>
         <padding>
            <Insets bottom="2.0" top="2.0" />
         </padding>
      </HBox>


      <HBox alignment="CENTER" prefHeight="196.0" prefWidth="748.0" spacing="30.0">
         <children>
            <ImageView fitHeight="50.0" fitWidth="38.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@assets/coin.png" />
               </image>
            </ImageView>
            <Label fx:id="coinsLabel"      text="0"           textFill="WHITE" />
            <Label fx:id="playerNameLabel" text="Player_Name" textFill="WHITE" />
            <Label fx:id="levelLabel"      text="Nível 1"     textFill="WHITE" />
         </children>
      </HBox>

   </children>
</VBox>
