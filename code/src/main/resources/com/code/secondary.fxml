<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="467.0" prefWidth="808.0" spacing="20.0" style="-fx-background-color: radial-gradient(radius 100%, blue, darkblue);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.code.SecondaryController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <TextField prefHeight="26.0" prefWidth="671.0" style="-fx-background-radius: 12px 0 0 12px;" />
            <Button mnemonicParsing="false" style="-fx-background-color: black; -fx-background-radius: 0 12px 12px 0;" text="Search" textFill="WHITE" />
         </children>
      </HBox>
      <TableView fx:id="table" prefHeight="371.0" prefWidth="740.0">
        <columns>
          <TableColumn fx:id="colName" prefWidth="257.0" text="Name" />
            <TableColumn fx:id="colLast" prefWidth="237.0" text="Last Played" />
            <TableColumn fx:id="colCreated" prefWidth="198.0" text="Created At" />
        </columns>
      </TableView>
      <HBox alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT" prefHeight="100.0" prefWidth="200.0" spacing="20.0">
         <children>
            <Button mnemonicParsing="false" style="-fx-background-color: linear-gradient(to top, black, gray);" text="New" textFill="WHITE" onAction="#novo" />
            <Button mnemonicParsing="false" prefHeight="10.0" prefWidth="131.0" style="-fx-background-color: linear-gradient(to top, black, gray);" text="Back" textFill="WHITE" onAction="#back" />
         </children>
      </HBox>
   </children>
</VBox>
